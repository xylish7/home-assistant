<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Electrical Panel</title>
  <link rel="stylesheet" href="../theme.css">
  <style>

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent; /* Elimină flash-ul albastru pe mobil */
    }

    html, body {
      width: 100%;
      height: 100%;
      background-color: #111111 !important;
      color: var(--text-main);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Inter", sans-serif;
      overflow: hidden;
      user-select: none;
      -webkit-user-select: none;
    }

    .container {
      display: flex;
      flex-direction: column;
      height: 100vh;
      max-height: 560px;
      background-color: #111111;
    }

    /* Bara de sus - fixă, mereu vizibilă */
    .din-rail-wrap {
      flex: 0 0 auto;
      padding: 12px 12px 8px 12px;
      background: #111111;
      position: relative;
      z-index: 5;
    }

    .din-rail {
      background: var(--rail-bg);
      border-radius: 18px;
      padding: 10px;
      display: flex;
      gap: 8px;
      border: 1px solid var(--card-border);
      overflow-x: auto;
      overflow-y: visible;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
    }

    .din-rail::-webkit-scrollbar {
      height: 4px;
    }

    .din-rail::-webkit-scrollbar-track {
      background: transparent;
    }

    .din-rail::-webkit-scrollbar-thumb {
      background: var(--card-border);
      border-radius: 10px;
    }

    /* Zona de jos - scrollabilă */
    .scroll-area {
      flex: 1 1 auto;
      overflow-y: auto;
      overflow-x: hidden;
      padding: 4px 12px 12px 12px;
      position: relative;
      -webkit-overflow-scrolling: touch;
    }

    .scroll-area::-webkit-scrollbar {
      width: 5px;
    }

    .scroll-area::-webkit-scrollbar-track {
      background: transparent;
    }

    .scroll-area::-webkit-scrollbar-thumb {
      background: var(--card-border);
      border-radius: 10px;
    }

    .mcb {
      flex: 0 0 52px;
      background: var(--mcb-bg);
      border: 1px solid var(--mcb-border);
      border-radius: 12px;
      padding: 8px 4px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      height: 114px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
      transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
      cursor: pointer;
      position: relative;
      outline: none;
    }

    .mcb:hover,
    .mcb.active {
      background: var(--mcb-hover);
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.45);
    }

    .mcb:active {
      transform: translateY(0) scale(0.97);
    }

    /* Inel / Ramă de evidențiere breaker */
    .mcb::before {
      content: "";
      position: absolute;
      inset: -1px;
      border-radius: 12px;
      border: 1.5px solid transparent;
      opacity: 0;
      transition: opacity 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
      pointer-events: none;
    }

    .mcb:hover::before,
    .mcb.active::before {
      opacity: 1;
    }

    .c25:hover::before, .c25.active::before { border-color: var(--c25-color); box-shadow: 0 0 10px var(--c25-soft); }
    .c20:hover::before, .c20.active::before { border-color: var(--c20-color); box-shadow: 0 0 10px var(--c20-soft); }
    .c16:hover::before, .c16.active::before { border-color: var(--c16-color); box-shadow: 0 0 10px var(--c16-soft); }
    .c10:hover::before, .c10.active::before { border-color: var(--c10-color); box-shadow: 0 0 10px var(--c10-soft); }

    .mcb-brand {
      font-size: 7px;
      font-weight: 700;
      color: var(--text-sub);
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }

    .mcb-switch-slot {
      width: 14px;
      height: 40px;
      background: #0a0a0a;
      border-radius: 8px;
      padding: 2px;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      border: 1px solid var(--card-border);
    }

    .mcb-toggle {
      width: 100%;
      height: 18px;
      border-radius: 6px;
    }

    .mcb-rating {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: -0.2px;
    }

    .c25 .mcb-toggle { background: var(--c25-color); }
    .c25 .mcb-rating { color: var(--c25-color); }
    .chip.c25 { background: var(--c25-soft); color: var(--c25-color); }

    .c20 .mcb-toggle { background: var(--c20-color); }
    .c20 .mcb-rating { color: var(--c20-color); }
    .chip.c20 { background: var(--c20-soft); color: var(--c20-color); }

    .c16 .mcb-toggle { background: var(--c16-color); }
    .c16 .mcb-rating { color: var(--c16-color); }
    .chip.c16 { background: var(--c16-soft); color: var(--c16-color); }

    .c10 .mcb-toggle { background: var(--c10-color); }
    .c10 .mcb-rating { color: var(--c10-color); }
    .chip.c10 { background: var(--c10-soft); color: var(--c10-color); }

    .circuit-list {
      display: flex;
      flex-direction: column;
      gap: 7px;
    }

    .circuit-card {
      display: flex;
      flex-direction: column;
      background: var(--content-bg);
      border: 1px solid var(--card-border);
      border-radius: 14px;
      transition: background 0.2s ease, border-color 0.25s ease, box-shadow 0.25s ease;
      overflow: hidden;
      border-left: 4px solid transparent;
      cursor: pointer;
    }

    .circuit-card:hover {
      background: var(--content-hover);
    }

    .circuit-card.linked {
      background: var(--content-hover);
    }

    .circuit-card.linked.c25 { border-left-color: var(--c25-color); box-shadow: 0 0 12px var(--c25-soft); }
    .circuit-card.linked.c20 { border-left-color: var(--c20-color); box-shadow: 0 0 12px var(--c20-soft); }
    .circuit-card.linked.c16 { border-left-color: var(--c16-color); box-shadow: 0 0 12px var(--c16-soft); }
    .circuit-card.linked.c10 { border-left-color: var(--c10-color); box-shadow: 0 0 12px var(--c10-soft); }

    .circuit-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 9px 14px;
    }

    .circuit-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .chip {
      font-size: 0.72rem;
      font-weight: 700;
      padding: 4px 9px;
      border-radius: 8px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 36px;
    }

    .circuit-info {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .circuit-title {
      font-size: 0.84rem;
      font-weight: 600;
      color: var(--text-main);
    }

    .circuit-sub {
      font-size: 0.72rem;
      color: var(--text-sub);
    }

    .expand-chevron {
      font-size: 0.8rem;
      color: var(--text-sub);
      transition: transform 0.2s ease;
    }

    .circuit-card.open .expand-chevron {
      transform: rotate(180deg);
    }

    .details-panel {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      background: rgba(0, 0, 0, 0.2);
      border-top: 1px solid transparent;
    }

    .circuit-card.open .details-panel {
      max-height: 320px;
      border-top: 1px solid var(--card-border);
    }

    .sockets-grid {
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 10px 14px 12px 14px;
    }

    .socket-row {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      font-size: 0.75rem;
      gap: 10px;
    }

    .socket-label {
      font-weight: 600;
      color: var(--text-main);
      flex-shrink: 0;
      min-width: 80px;
    }

    .socket-devices {
      color: var(--text-sub);
      text-align: right;
      font-size: 0.7rem;
      line-height: 1.4;
    }
  </style>
</head>
<body>

  <div class="container">
    <!-- Breakers Bar - FIXĂ (Toate cele 6 siguranțe originale păstrate) -->
    <div class="din-rail-wrap">
      <div class="din-rail" id="din-rail">
        <div class="mcb c25" id="mcb-general" onclick="handleMcbClick('circuit-general')">
          <span class="mcb-brand">Legrand</span>
          <div class="mcb-switch-slot"><div class="mcb-toggle"></div></div>
          <span class="mcb-rating">C25</span>
        </div>

        <div class="mcb c20" id="mcb-hol" onclick="handleMcbClick('circuit-hol')">
          <span class="mcb-brand">Legrand</span>
          <div class="mcb-switch-slot"><div class="mcb-toggle"></div></div>
          <span class="mcb-rating">C20</span>
        </div>

        <div class="mcb c16" id="mcb-baie" onclick="handleMcbClick('circuit-baie')">
          <span class="mcb-brand">Legrand</span>
          <div class="mcb-switch-slot"><div class="mcb-toggle"></div></div>
          <span class="mcb-rating">C16</span>
        </div>

        <div class="mcb c16" id="mcb-kitchen" onclick="handleMcbClick('circuit-kitchen')">
          <span class="mcb-brand">Legrand</span>
          <div class="mcb-switch-slot"><div class="mcb-toggle"></div></div>
          <span class="mcb-rating">C16</span>
        </div>

        <div class="mcb c16" id="mcb-living" onclick="handleMcbClick('circuit-living')">
          <span class="mcb-brand">Legrand</span>
          <div class="mcb-switch-slot"><div class="mcb-toggle"></div></div>
          <span class="mcb-rating">C16</span>
        </div>

        <div class="mcb c10" id="mcb-lights" onclick="handleMcbClick('circuit-lights')">
          <span class="mcb-brand">Legrand</span>
          <div class="mcb-switch-slot"><div class="mcb-toggle"></div></div>
          <span class="mcb-rating">C10</span>
        </div>
      </div>
    </div>

    <!-- Lista Circuite - SCROLLABILĂ (Toate cele 6 carduri originale cu textele actualizate) -->
    <div class="scroll-area">
      <div class="circuit-list">

        <!-- Siguranță Generală C25 -->
        <div class="circuit-card c25" id="circuit-general" data-breaker-id="mcb-general" onclick="handleCardClick('circuit-general')">
          <div class="circuit-header">
            <div class="circuit-left">
              <span class="chip c25">C25</span>
              <div class="circuit-info">
                <span class="circuit-title">Siguranță Generală</span>
                <span class="circuit-sub">Oprire totală instalație</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Circuit 4 — Siguranță C20 (Utilități / Climatizare) -->
        <div class="circuit-card c20" id="circuit-hol" data-breaker-id="mcb-hol" onclick="handleCardClick('circuit-hol')">
          <div class="circuit-header">
            <div class="circuit-left">
              <span class="chip c20">C20</span>
              <div class="circuit-info">
                <span class="circuit-title">Circuit 4 — Utilități / Climatizare</span>
                <span class="circuit-sub">Hol, Camera de zi (2 locații)</span>
              </div>
            </div>
            <span class="expand-chevron">▼</span>
          </div>

          <div class="details-panel">
            <div class="sockets-grid">
              <div class="socket-row">
                <span class="socket-label">Hol</span>
                <span class="socket-devices">1 × priză simplă — Ușă intrare</span>
              </div>
              <div class="socket-row">
                <span class="socket-label">Camera de zi</span>
                <span class="socket-devices">1 × priză simplă — Perete / tavan (aer condiționat)</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Circuit 3 — Siguranță C16 (Dormitor, Baie) -->
        <div class="circuit-card c16" id="circuit-baie" data-breaker-id="mcb-baie" onclick="handleCardClick('circuit-baie')">
          <div class="circuit-header">
            <div class="circuit-left">
              <span class="chip c16">C16</span>
              <div class="circuit-info">
                <span class="circuit-title">Circuit 3 — Dormitor, Baie</span>
                <span class="circuit-sub">4 locații de priză</span>
              </div>
            </div>
            <span class="expand-chevron">▼</span>
          </div>

          <div class="details-panel">
            <div class="sockets-grid">
              <div class="socket-row">
                <span class="socket-label">Dormitor</span>
                <span class="socket-devices">2 × priză dublă — Pat (noptiere)<br>1 × priză dublă — Perete</span>
              </div>
              <div class="socket-row">
                <span class="socket-label">Baie</span>
                <span class="socket-devices">1 × priză simplă — Baie</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Circuit 2 — Siguranță C16 (Bucătărie) -->
        <div class="circuit-card c16" id="circuit-kitchen" data-breaker-id="mcb-kitchen" onclick="handleCardClick('circuit-kitchen')">
          <div class="circuit-header">
            <div class="circuit-left">
              <span class="chip c16">C16</span>
              <div class="circuit-info">
                <span class="circuit-title">Circuit 2 — Bucătărie</span>
                <span class="circuit-sub">4 locații • 7 posturi</span>
              </div>
            </div>
            <span class="expand-chevron">▼</span>
          </div>

          <div class="details-panel">
            <div class="sockets-grid">
              <div class="socket-row">
                <span class="socket-label">Electrocasnice</span>
                <span class="socket-devices">1 × priză dublă — Mașină de spălat</span>
              </div>
              <div class="socket-row">
                <span class="socket-label">Încălzire</span>
                <span class="socket-devices">1 × priză dublă — Centrală termică</span>
              </div>
              <div class="socket-row">
                <span class="socket-label">Blat de lucru</span>
                <span class="socket-devices">1 × priză dublă — Zonă chiuvetă / blat</span>
              </div>
              <div class="socket-row">
                <span class="socket-label">Gătire</span>
                <span class="socket-devices">1 × priză simplă — Cuptor</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Circuit 1 — Siguranță C16 (Living, Hol, Cameră Copii) -->
        <div class="circuit-card c16" id="circuit-living" data-breaker-id="mcb-living" onclick="handleCardClick('circuit-living')">
          <div class="circuit-header">
            <div class="circuit-left">
              <span class="chip c16">C16</span>
              <div class="circuit-info">
                <span class="circuit-title">Circuit 1 — Bucătărie, Cameră de zi, Hol, Cameră Copii</span>
                <span class="circuit-sub">Bucătărie, Camera de zi, Hol, Cameră copii (7 locații)</span>
              </div>
            </div>
            <span class="expand-chevron">▼</span>
          </div>

          <div class="details-panel">
            <div class="sockets-grid">
              <div class="socket-row">
                <span class="socket-label">Bucătărie</span>
                <span class="socket-devices">1 × priză simplă — Frigider, AC</span>
              </div>
              <div class="socket-row">
                <span class="socket-label">Camera de zi</span>
                <span class="socket-devices">1 × priză dublă — TV<br>1 × priză dublă — Calculator<br>1 × priză dublă — Canapea living</span>
              </div>
              <div class="socket-row">
                <span class="socket-label">Hol</span>
                <span class="socket-devices">1 × priză simplă — Hol ușă baie</span>
              </div>
              <div class="socket-row">
                <span class="socket-label">Cameră copii</span>
                <span class="socket-devices">1 × priză dublă — Google Home<br>2 × priză dublă — Pat (stânga / dreapta)</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Siguranță C10 — Iluminat -->
        <div class="circuit-card c10" id="circuit-lights" data-breaker-id="mcb-lights" onclick="handleCardClick('circuit-lights')">
          <div class="circuit-header">
            <div class="circuit-left">
              <span class="chip c10">C10</span>
              <div class="circuit-info">
                <span class="circuit-title">Iluminat</span>
                <span class="circuit-sub">Toate circuitele de corpuri iluminat</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <script>
    const scrollArea = document.querySelector('.scroll-area');
    const dinRail = document.getElementById('din-rail');

    // Scroll vertical către card
    function scrollToCard(card) {
      const scrollAreaRect = scrollArea.getBoundingClientRect();
      const cardRect = card.getBoundingClientRect();
      const targetOffset = (cardRect.top - scrollAreaRect.top) + scrollArea.scrollTop - 8;

      scrollArea.scrollTo({
        top: Math.max(0, targetOffset),
        behavior: 'smooth'
      });
    }

    // Scroll orizontal către siguranță (MCB)
    function scrollToMcb(mcb) {
      const railRect = dinRail.getBoundingClientRect();
      const mcbRect = mcb.getBoundingClientRect();
      const targetOffset = (mcbRect.left - railRect.left) + dinRail.scrollLeft - (railRect.width / 2) + (mcbRect.width / 2);

      dinRail.scrollTo({
        left: Math.max(0, targetOffset),
        behavior: 'smooth'
      });
    }

    function clearHighlights() {
      document.querySelectorAll('.circuit-card.linked').forEach(c => c.classList.remove('linked'));
      document.querySelectorAll('.mcb.active').forEach(m => m.classList.remove('active'));
    }

    // Click pe un MCB de sus
    function handleMcbClick(cardId) {
      const card = document.getElementById(cardId);
      if (!card) return;

      const breakerId = card.getAttribute('data-breaker-id');
      const mcb = document.getElementById(breakerId);

      clearHighlights();
      card.classList.add('linked');
      if (mcb) mcb.classList.add('active');

      scrollToCard(card);

      const detailsPanel = card.querySelector('.details-panel');
      if (detailsPanel && !card.classList.contains('open')) {
        card.classList.add('open');
      }
    }

    // Click pe descriere / card
    function handleCardClick(cardId) {
      const card = document.getElementById(cardId);
      if (!card) return;

      const breakerId = card.getAttribute('data-breaker-id');
      const mcb = document.getElementById(breakerId);

      clearHighlights();
      card.classList.add('linked');

      if (mcb) {
        mcb.classList.add('active');
        scrollToMcb(mcb);
      }

      // Deschide/închide detaliile dacă există
      const detailsPanel = card.querySelector('.details-panel');
      if (detailsPanel) {
        card.classList.toggle('open');
      }
    }
  </script>

</body>
</html>